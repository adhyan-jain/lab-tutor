# ============================================================================
# LabTutor environment configuration
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored. NEVER commit real secrets to this repo.
# ============================================================================

# --- Core ---------------------------------------------------------------
# The hostname Caddy serves and obtains a TLS certificate for. Set this to
# your real domain before deploying: left unset it falls back to localhost
# and serves an internally-trusted certificate (localhost development).
LABTUTOR_DOMAIN=localhost
# Address Let's Encrypt uses for expiry notices. Leave as "internal" to
# skip public certificate issuance (localhost development).
LABTUTOR_TLS_EMAIL=internal

# Public origin the app is served from (used to build OAuth redirect URIs).
LABTUTOR_PUBLIC_URL=http://localhost:3000
# Signs session cookies. Generate with: openssl rand -hex 32
LABTUTOR_SESSION_SECRET=dev-insecure-secret-change-in-production
# development | production. Controls cookie Secure flag + error verbosity.
LABTUTOR_ENV=development

# --- Database -----------------------------------------------------------
# Bundled local Docker database (default)
POSTGRES_USER=labtutor
POSTGRES_PASSWORD=labtutor
POSTGRES_DB=labtutor
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional Database URL override:
# Set this to connect to a remote serverless database (e.g. Neon, Supabase, Cloud SQL)
#
# Example (Neon Serverless Postgres - Recommended for $0 idle cost):
# LABTUTOR_DATABASE_URL=postgresql+psycopg://username:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# Example (Supabase):
# LABTUTOR_DATABASE_URL=postgresql+psycopg://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#
# LABTUTOR_DATABASE_URL=

# Per-process connection pool size.
LABTUTOR_DB_POOL_SIZE=20
LABTUTOR_DB_MAX_OVERFLOW=10

# --- Role domains -------------------------------------------------------
# Server-side role determination reads these. Comma-separated domains;
# matching is case-insensitive on the domain part of the email.
LABTUTOR_STUDENT_DOMAINS=vitstudent.ac.in
LABTUTOR_FACULTY_DOMAINS=vit.ac.in
# Platform administrator allowlist, checked before domain-role resolution.
LABTUTOR_ADMIN_EMAILS=adhyanjain2006@gmail.com

# --- Google OAuth -------------------------------------------------------
# From https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: ${LABTUTOR_PUBLIC_URL}/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Primary LLM Provider (OpenAI) --------------------------------------
# GPT=true routes all LLM generations directly to OpenAI.
GPT=true
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
# Optional; passed only if set (for models supporting reasoning effort).
OPENAI_REASONING_EFFORT=

# Caps simultaneous in-flight LLM calls across every student/caller.
# Set to the expected peak headcount (e.g. 70) so students get a slot immediately.
LABTUTOR_LLM_MAX_CONCURRENCY=70
LABTUTOR_LLM_BACKGROUND_CONCURRENCY=4
LABTUTOR_LLM_QUEUE_TIMEOUT_SECONDS=10.0
LABTUTOR_LLM_TIMEOUT_SECONDS=30
LABTUTOR_LLM_MAX_TOKENS=1200
LABTUTOR_LLM_TEMPERATURE=0.3

# When false (recommended), OpenAI outages gracefully degrade to deterministic
# course manual extractions ($0 unexpected cross-provider billing).
LABTUTOR_LLM_AUTO_FALLBACK=false

# --- Experiment & Pedagogy Settings ------------------------------------
# Students have only a phone and this website: Exp7's "practical" runs as
# a conceptual session that never asks them to use or read external software.
# Set false for a class that has Gabedit/ORCA/Avogadro on lab PCs.
LABTUTOR_PHONE_ONLY=true

# Guided, verified step-by-step walkthrough for Exp7.
LABTUTOR_WALKTHROUGH=true

# Path to the course manual Markdown, mounted into the backend container.
LABTUTOR_MANUAL_PDF=/app/manual/IACHY102_manual.md

# --- Conversational router ---------------------------------------------
LABTUTOR_ROUTER_ENABLED=true
LABTUTOR_ROUTER_MIN_CONFIDENCE=0.4
LABTUTOR_ROUTER_TIMEOUT_SECONDS=8.0

# --- Rate limiting -----------------------------------------------------
LABTUTOR_RATELIMIT_SOCRATIC_PER_MINUTE=30
LABTUTOR_RATELIMIT_SUBMIT_PER_HOUR=60
LABTUTOR_RATELIMIT_QA_PER_MINUTE=30

# --- Summaries ---------------------------------------------------------
LABTUTOR_SUMMARY_WORKERS=4

# --- Optional Alternative Provider Configurations (Unused when GPT=true) -
LABTUTOR_LLM_BACKEND=hosted
LABTUTOR_LLM_BASE_URL=
LABTUTOR_LLM_API_KEY=
LABTUTOR_LLM_MODEL=
LABTUTOR_LLM_MAX_ATTEMPTS=3
LABTUTOR_LLM_RETRY_INITIAL_SECONDS=1.0
LABTUTOR_LLM_RETRY_MAX_SECONDS=8.0
LABTUTOR_LLM_RETRY_BUDGET_SECONDS=25.0
LABTUTOR_LLM_THINKING_BUDGET=-1
LABTUTOR_LLM_CONTEXT_CACHE=false
LABTUTOR_LLM_CONTEXT_CACHE_SCOPES=exp07
LABTUTOR_LLM_CONTEXT_CACHE_TTL_SECONDS=10800
# LABTUTOR_LLM_PRICE_PROMPT_PER_MILLION_USD=
# LABTUTOR_LLM_PRICE_COMPLETION_PER_MILLION_USD=
LABTUTOR_OLLAMA_BASE_URL=http://localhost:11434
LABTUTOR_OLLAMA_MODEL=qwen2.5:7b
LABTUTOR_OLLAMA_THINK=false
LABTUTOR_VERTEX_PROJECT=
LABTUTOR_VERTEX_LOCATION=asia-south1
LABTUTOR_VERTEX_MODEL=gemini-2.5-flash
