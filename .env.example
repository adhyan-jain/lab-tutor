# ============================================================================
# LabTutor environment configuration
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored. NEVER commit real secrets to this repo.
#
# Adding creds here and running `docker compose up` is the entire
# deployment procedure -- see README.md "Deployment".
# ============================================================================

# --- Core ---------------------------------------------------------------
# The hostname Caddy serves and obtains a TLS certificate for. Set this to
# your real domain before deploying: left unset it falls back to localhost
# and serves an internally-trusted certificate, which is right for local
# work and wrong for a pilot.
LABTUTOR_DOMAIN=labtutor.example.ac.in
# Address Let's Encrypt uses for expiry notices. Leave as "internal" to
# skip public certificate issuance (localhost development).
LABTUTOR_TLS_EMAIL=lab-admin@example.ac.in

# Public origin the app is served from (used to build OAuth redirect URIs).
# Normally https:// + LABTUTOR_DOMAIN.
LABTUTOR_PUBLIC_URL=https://labtutor.example.ac.in
# Signs session cookies. Generate with: openssl rand -hex 32
LABTUTOR_SESSION_SECRET=CHANGEME_generate_with_openssl_rand_hex_32
# development | production. Controls cookie Secure flag + error verbosity.
LABTUTOR_ENV=production

# --- Database -----------------------------------------------------------
POSTGRES_USER=labtutor
POSTGRES_PASSWORD=CHANGEME_postgres_password
POSTGRES_DB=labtutor
# Host/port as seen from the backend container.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional. Overrides the assembled Postgres URL entirely, ignoring every
# POSTGRES_* value above. The test suite sets it to a SQLite file; leave it
# unset in any real deployment, where setting it by accident would silently
# point the app at a different database.
# LABTUTOR_DATABASE_URL=
#
# Example: pointing at a remote Supabase project instead of the bundled
# `db` container (see README "Remote DB (Supabase)"). Use the DIRECT
# connection (port 5432), not the pgbouncer transaction pooler on 6543.
# LABTUTOR_DATABASE_URL=postgresql://postgres:CHANGEME@db.CHANGEME.supabase.co:5432/postgres

# --- Role domains -------------------------------------------------------
# Server-side role determination reads these. They are environment
# variables specifically so an additional/corrected domain can be added
# WITHOUT a code change (see backend/auth/roles.py). Comma-separated;
# matching is case-insensitive and exact on the domain part of the email.
LABTUTOR_STUDENT_DOMAINS=vitstudent.ac.in
LABTUTOR_FACULTY_DOMAINS=vit.ac.in
# Platform administrator allowlist, checked before domain-role resolution.
LABTUTOR_ADMIN_EMAILS=adhyanjain2006@gmail.com

# --- Google OAuth -------------------------------------------------------
# From https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: ${LABTUTOR_PUBLIC_URL}/api/auth/callback
GOOGLE_CLIENT_ID=CHANGEME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGEME_google_client_secret

# --- LLM inference backend ----------------------------------------------
# Which backend to use: "hosted" (primary, for the pilot) or "ollama"
# (local dev/fallback only -- NOT recommended for 70 concurrent users,
# see README "Inference backends").
LABTUTOR_LLM_BACKEND=hosted

# Hosted backend. Provider-agnostic: any OpenAI-compatible chat
# completions endpoint (Cerebras, Groq, OpenAI, Together, ...).
# The provider is NOT hardcoded anywhere in the code.
LABTUTOR_LLM_BASE_URL=https://api.cerebras.ai/v1
LABTUTOR_LLM_API_KEY=CHANGEME_hosted_llm_api_key
LABTUTOR_LLM_MODEL=llama-3.3-70b
LABTUTOR_LLM_TIMEOUT_SECONDS=30
LABTUTOR_LLM_MAX_TOKENS=400
# Caps simultaneous in-flight LLM calls across every caller (chat, phrasing,
# the Exp8 qualitative note) so a slow/degrading provider under ~70 concurrent
# students can't put ~70 requests in flight at once.
LABTUTOR_LLM_MAX_CONCURRENCY=20

# Ollama fallback (dev only).
LABTUTOR_OLLAMA_BASE_URL=http://ollama:11434
LABTUTOR_OLLAMA_MODEL=llama3.1:8b
# Off by default: some local models (e.g. qwen3) spend tokens on an internal
# "thinking" pass before the visible reply, which can exhaust LABTUTOR_LLM_MAX_TOKENS
# before any reply is produced. Turn on only if you also raise that budget.
LABTUTOR_OLLAMA_THINK=false

# If the primary backend fails, automatically fall back to Ollama when
# it is reachable. If false, failures surface as maintenance-mode
# degraded responses instead. See README "Rollback plan".
LABTUTOR_LLM_AUTO_FALLBACK=true

# --- Conversational router ------------------------------------------------
# LLM-driven routing in front of the deterministic QA/Socratic/diagnostic
# dispatch (backend/router/). Any failure falls back to the pre-existing
# keyword-based dispatch unchanged, so this is a zero-risk kill switch.
LABTUTOR_ROUTER_ENABLED=true
# Below this, a router decision is treated the same as a router failure.
LABTUTOR_ROUTER_MIN_CONFIDENCE=0.4
# Deliberately short: routing is an enhancement, not core functionality,
# and must fail fast into the deterministic dispatch rather than compound
# with the domain LLM call's own (much longer) timeout.
LABTUTOR_ROUTER_TIMEOUT_SECONDS=8.0

# --- Retrieval ----------------------------------------------------------
# Path to the course manual PDF, mounted into the backend container.
# Retrieval and every Tier 1 experiment plugin are derived from THIS file.
LABTUTOR_MANUAL_PDF=/app/manual/IACHY102_manual.md

# --- Rate limiting ------------------------------------------------------
# Per-user limits protecting the inference backend.
LABTUTOR_RATELIMIT_SOCRATIC_PER_MINUTE=12
LABTUTOR_RATELIMIT_SUBMIT_PER_HOUR=30
LABTUTOR_RATELIMIT_QA_PER_MINUTE=12

# --- Summaries ----------------------------------------------------------
# Concurrency of the async per-student summary job.
LABTUTOR_SUMMARY_WORKERS=4
