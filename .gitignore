# --- Environment / secrets ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Python (backend) ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# --- Node / Next.js (frontend) ---
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Databases / local state ---
*.sqlite3
*.db
postgres-data/

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Misc build artifacts ---
*.log
.cache/
frontend/tsconfig.tsbuildinfo

# --- Jupyter notebooks (scratch/dev scripts, not course content) ---
*.ipynb

# --- Lab manuals and working documents (large binary files) ---
*.docx
*.pdf

# --- Playwright MCP browser-testing snapshots ---
# Accessibility-tree/screenshot dumps written to disk on every
# browser_snapshot call during interactive testing sessions -- local
# debug artifacts, not part of the app.
.playwright-mcp/

# --- Course material ---
# The manual is the source of truth for every formula in this system, but
# it is the department's material; whether it may be redistributed is
# their call. Keep the directory, ignore the PDF. See manual/README.md.
manual/*.pdf
manual/*.PDF
